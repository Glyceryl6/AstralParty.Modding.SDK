<Project>
  <!-- Resolve native game references during MSBuild evaluation, not only in a late .targets import.
       必须在项目引用求值之前解析游戏路径，Rider 的设计时项目加载也依赖此结果。 -->
  <PropertyGroup>
    <AstralGameDir Condition="'$(AstralGameDir)' == '' and '$(ASTRAL_PARTY_GAME_DIR)' != ''">$(ASTRAL_PARTY_GAME_DIR)</AstralGameDir>
    <AstralInteropDir Condition="'$(AstralInteropDir)' == '' and '$(ASTRAL_PARTY_INTEROP_DIR)' != ''">$(ASTRAL_PARTY_INTEROP_DIR)</AstralInteropDir>
    <AstralInteropDir Condition="'$(AstralInteropDir)' == '' and '$(AstralGameDir)' != ''">$(AstralGameDir)/BepInEx/interop</AstralInteropDir>
    <!-- Optional local proxy copies for standalone SDK workspaces. -->
    <AstralInteropDir Condition="'$(AstralInteropDir)' == '' and Exists('$(MSBuildProjectDirectory)/lib/interop/UnityEngine.CoreModule.dll')">$(MSBuildProjectDirectory)/lib/interop</AstralInteropDir>
    <AstralInteropDir Condition="'$(AstralInteropDir)' == '' and Exists('$(MSBuildThisFileDirectory)../lib/interop/UnityEngine.CoreModule.dll')">$(MSBuildThisFileDirectory)../../lib/interop</AstralInteropDir>
  </PropertyGroup>
</Project>
